# Copy to .env and fill in. Never commit the real .env.

# Required to post as the board owner and to moderate.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Required. Signs admin session cookies and salts the rate-limit hashes.
# Generate the same way. Changing it logs out admins and resets rate limits.
SECRET_KEY=

# Optional
PORT=3000
HOST=127.0.0.1
BOARD_TITLE=Anonymous Board
BOARD_TAGLINE=Say what you need to say.
DB_PATH=./data/board.db

# Set to 1 only when running behind a reverse proxy you control,
# so the real client IP is read from X-Forwarded-For for rate limiting.
TRUST_PROXY=0
